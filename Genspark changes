diff --git a/src/studymode/lib/generationHistory.ts b/src/studymode/lib/generationHistory.ts
new file mode 100644
index 0000000..51ab6c3
--- /dev/null
+++ b/src/studymode/lib/generationHistory.ts
@@ -0,0 +1,207 @@
+import { supabase } from '@/integrations/supabase/client';
+import { logger } from '@/utils/logger';
+
+export interface GenerationHistoryEntry {
+  id: string;
+  activity_type: string;
+  subject: string;
+  topic: string | null;
+  metadata: Record<string, any> | null;
+  created_at: string;
+}
+
+interface LoadOptions {
+  userId: string;
+  subject: string;
+  topic?: string | null;
+  activityTypes?: string[];
+  limit?: number;
+}
+
+interface LogOptions {
+  userId: string;
+  subject: string;
+  topic?: string | null;
+  activityType: string;
+  metadata?: Record<string, unknown>;
+  taskCompleted?: boolean;
+  score?: number | null;
+  durationMinutes?: number | null;
+}
+
+function normalizeText(value: string): string {
+  return value
+    .toLowerCase()
+    .replace(/\$[^$]*\$/g, ' ')
+    .replace(/[*_#>`~\[\](){}]/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+export function hashText(value: string): string {
+  const text = normalizeText(value);
+  let hash = 5381;
+  for (let i = 0; i < text.length; i += 1) {
+    hash = ((hash << 5) + hash) + text.charCodeAt(i);
+    hash |= 0;
+  }
+  return `h${Math.abs(hash)}`;
+}
+
+export function fingerprintQuestionStem(value: string): string {
+  const normalized = normalizeText(value)
+    .replace(/^(question\s*\d+[:.)-]?|q\d+[:.)-]?|\d+[:.)-]?)/, '')
+    .split(/[.?!\n]/)[0]
+    .trim();
+  return hashText(normalized.slice(0, 180));
+}
+
+export function dedupeStrings(values: Array<string | null | undefined>, limit = 12): string[] {
+  const seen = new Set<string>();
+  const result: string[] = [];
+  for (const value of values) {
+    const cleaned = (value || '').trim();
+    if (!cleaned || seen.has(cleaned)) continue;
+    seen.add(cleaned);
+    result.push(cleaned);
+    if (result.length >= limit) break;
+  }
+  return result;
+}
+
+export function extractQuestionFingerprintsFromMarkdown(content: string): string[] {
+  const matches = content.match(/(?:^|\n)(?:\*\*)?(?:q(?:uestion)?\s*\d+|\d+)[^\n:]*[:.)-]?\s+([^\n]+)/gi) || [];
+  return dedupeStrings(matches.map((line) => fingerprintQuestionStem(line)), 16);
+}
+
+export function extractSubtopicFocusFromMarkdown(content: string): string | null {
+  const explicit = content.match(/subtopic\s*focus\s*:\s*(.+)/i);
+  if (explicit?.[1]) return explicit[1].trim();
+
+  const heading = content.match(/^##+\s+(.+)$/m);
+  if (!heading?.[1]) return null;
+
+  return heading[1]
+    .replace(/^topic summary:\s*/i, '')
+    .replace(/^active recall:\s*/i, '')
+    .replace(/^flashcards:\s*/i, '')
+    .replace(/^concept deep-dive:\s*/i, '')
+    .trim();
+}
+
+export function extractRecentContext(entries: GenerationHistoryEntry[]) {
+  const recentQuestionFingerprints = dedupeStrings(
+    entries.flatMap((entry) => {
+      const metadata = entry.metadata || {};
+      const fromArray = Array.isArray(metadata.questionFingerprints) ? metadata.questionFingerprints : [];
+      const fromStem = typeof metadata.questionFingerprint === 'string' ? [metadata.questionFingerprint] : [];
+      return [...fromArray, ...fromStem];
+    }),
+    18,
+  );
+
+  const recentSubtopics = dedupeStrings(
+    entries.flatMap((entry) => {
+      const metadata = entry.metadata || {};
+      const direct = typeof metadata.subtopicFocus === 'string' ? [metadata.subtopicFocus] : [];
+      const list = Array.isArray(metadata.subtopics) ? metadata.subtopics : [];
+      return [...direct, ...list];
+    }),
+    12,
+  );
+
+  const recentConcepts = dedupeStrings(
+    entries.flatMap((entry) => {
+      const metadata = entry.metadata || {};
+      return Array.isArray(metadata.concepts) ? metadata.concepts : [];
+    }),
+    20,
+  );
+
+  const recentTitles = dedupeStrings(
+    entries.flatMap((entry) => {
+      const metadata = entry.metadata || {};
+      const title = typeof metadata.title === 'string' ? metadata.title : null;
+      const prompt = typeof metadata.promptTitle === 'string' ? metadata.promptTitle : null;
+      return [title, prompt];
+    }),
+    10,
+  );
+
+  return {
+    recentQuestionFingerprints,
+    recentSubtopics,
+    recentConcepts,
+    recentTitles,
+  };
+}
+
+export async function loadRecentGenerationHistory({
+  userId,
+  subject,
+  topic,
+  activityTypes,
+  limit = 12,
+}: LoadOptions): Promise<GenerationHistoryEntry[]> {
+  try {
+    let query = supabase
+      .from('study_activity')
+      .select('id, activity_type, subject, topic, metadata, created_at')
+      .eq('user_id', userId)
+      .eq('subject', subject)
+      .order('created_at', { ascending: false })
+      .limit(limit);
+
+    if (topic) {
+      query = query.eq('topic', topic);
+    }
+
+    if (activityTypes && activityTypes.length > 0) {
+      query = query.in('activity_type', activityTypes);
+    }
+
+    const { data, error } = await query;
+    if (error) {
+      logger.warn('[generationHistory] Failed to load history:', error.message);
+      return [];
+    }
+
+    return (data || []) as GenerationHistoryEntry[];
+  } catch (error) {
+    logger.warn('[generationHistory] Unexpected load error:', error);
+    return [];
+  }
+}
+
+export async function logGenerationHistory({
+  userId,
+  subject,
+  topic,
+  activityType,
+  metadata = {},
+  taskCompleted = true,
+  score = null,
+  durationMinutes = null,
+}: LogOptions): Promise<void> {
+  try {
+    const { error } = await supabase
+      .from('study_activity')
+      .insert({
+        user_id: userId,
+        subject,
+        topic: topic || null,
+        activity_type: activityType,
+        task_completed: taskCompleted,
+        score,
+        duration_minutes: durationMinutes,
+        metadata: metadata as any,
+        date: new Date().toISOString().split('T')[0],
+      });
+
+    if (error) {
+      logger.warn('[generationHistory] Failed to log history:', error.message);
+    }
+  } catch (error) {
+    logger.warn('[generationHistory] Unexpected log error:', error);
+  }
+}
